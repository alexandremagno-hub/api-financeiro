ENVIRONMENT=development

DATABASE_URL=mysql+pymysql://financeiro:financeiro@localhost:3306/financeiro?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# Gere cada chave com:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
# NUNCA reutilize estes valores de exemplo.
JWE_ACCESS_KEY=troque-por-uma-chave-de-32-bytes-em-base64url-xxxx
JWE_REFRESH_KEY=troque-por-outra-chave-de-32-bytes-em-base64url-yy

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Em desenvolvimento local via http://localhost, use false. Em produção, SEMPRE true.
COOKIE_SECURE=true

# Caminho do cookie de refresh como o navegador vê (API publicada em /api pelo proxy).
REFRESH_COOKIE_PATH=/api/auth

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

SIGNUP_MAX_PER_IP=10
SIGNUP_WINDOW_SECONDS=3600
